<Project Sdk="Microsoft.NET.Sdk">

  <!-- Publish assembles the release layout in Shipping\, see docs/DEVELOPER.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Multiplayer</AssemblyName>
    <RootNamespace>MGQOnline.Multiplayer</RootNamespace>
    <Product>Monster Girl Quest! Online</Product>
    <Version>0.0.0-dev</Version>

    <!-- The game is a 32-bit process and only loads a native DLL of its own kind. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>

    <PackageDir>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), .., Shipping))</PackageDir>
    <ZipFile>$(MSBuildProjectDirectory)\bin\$(Configuration)\MGQ-Online-$(Version).zip</ZipFile>
  </PropertyGroup>

  <!-- NativeAOT's compiler at 10.0.14, which fixes advisory GHSA-p3jp-9v83-76w9; the SDK brings an
       older one. -->
  <ItemGroup>
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" ILCompilerPackVersion="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MGQOnline.Multiplayer.Tests" />
  </ItemGroup>

  <!-- The bridge's four exports live in MGQOnline.Bridge.Native, which NativeAOT exports from only
       because it is named an UnmanagedEntryPointsAssembly here; GameBridge installs their host.
       NativeAOT runs a module initializer only for an assembly it compiled code of, and nothing
       but the initializer reaches this one, so it is rooted. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="$(AssemblyName)" />
    <ProjectReference Include="..\MGQOnline.Bridge.Native\MGQOnline.Bridge.Native.csproj" />
    <UnmanagedEntryPointsAssembly Include="MGQOnline.Bridge.Native" />
  </ItemGroup>

  <!-- The game's rules that left the scripts, which the bridge topics answer with. -->
  <ItemGroup>
    <ProjectReference Include="..\MGQOnline.Game\MGQOnline.Game.csproj" />
  </ItemGroup>

  <!-- The events database's reader, with SQLite linked into the DLL (see the imported targets). -->
  <ItemGroup>
    <ProjectReference Include="..\MGQOnline.Data\MGQOnline.Data.csproj" />
  </ItemGroup>
  <Import Project="..\MGQOnline.Data\native\StaticSqlite.targets" />

  <ItemGroup>
    <!-- Multiplayer.rb goes into the Patch folder, where the mod loader finds it; everything else
         goes into Patch\Multiplayer, the other scripts into its Scripts folder, which
         Multiplayer.rb loads itself, and the events database, generated by hand and committed,
         into its Data folder. -->
    <PatchFile Include="..\GameScript\Multiplayer.rb" />
    <ModFile Include="..\package\Multiplayer\*" />
    <DataFile Include="..\package\Multiplayer\Data\events.db" />
    <ScriptFile Include="..\GameScript\Multiplayer\Scripts\*.rbx" />

    <!-- What the helper's update compares an older install's Manifest.txt against, to remove
         files a refactor dropped. Built from the same globs the package itself is, so a rename
         never needs updating by hand. -->
    <ShippedFile Include="Patch\Multiplayer\$(AssemblyName).dll" />
    <ShippedFile Include="Patch\Multiplayer\Manifest.txt" />
    <ShippedFile Include="@(ModFile->'Patch\Multiplayer\%(Filename)%(Extension)')" />
    <ShippedFile Include="@(DataFile->'Patch\Multiplayer\Data\%(Filename)%(Extension)')" />
    <ShippedFile Include="@(ScriptFile->'Patch\Multiplayer\Scripts\%(Filename)%(Extension)')" />
    <ShippedFile Include="@(PatchFile->'Patch\%(Filename)%(Extension)')" />

    <None Include="@(ModFile)" Link="Shipped\Patch\Multiplayer\%(Filename)%(Extension)" />
    <None Include="@(DataFile)" Link="Shipped\Patch\Multiplayer\Data\%(Filename)%(Extension)" />
    <None Include="@(ScriptFile)" Link="Shipped\Patch\Multiplayer\Scripts\%(Filename)%(Extension)" />
    <None Include="@(PatchFile)" Link="Shipped\Patch\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="AssemblePackage" AfterTargets="Publish">
    <Error Condition="!Exists('@(DataFile)')" Text="The events database is missing: build @(DataFile) with MGQOnline.Data.Generator, see docs/DEVELOPER.md." />
    <RemoveDir Directories="$(PackageDir)" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).dll;@(ModFile)" DestinationFolder="$(PackageDir)Patch\Multiplayer" />
    <Copy SourceFiles="@(ScriptFile)" DestinationFolder="$(PackageDir)Patch\Multiplayer\Scripts" />
    <Copy SourceFiles="@(DataFile)" DestinationFolder="$(PackageDir)Patch\Multiplayer\Data" />
    <Copy SourceFiles="@(PatchFile)" DestinationFolder="$(PackageDir)Patch" />
    <WriteLinesToFile File="$(PackageDir)Patch\Multiplayer\Manifest.txt" Lines="@(ShippedFile)" Overwrite="true" />
    <Message Importance="high" Text="$(MSBuildProjectName) -> $(PackageDir)" />
  </Target>

  <Target Name="ZipPackage" AfterTargets="AssemblePackage" Condition="'$(Configuration)' == 'Release'">
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="$(ZipFile)" Overwrite="true" />
  </Target>

</Project>
