<Project Sdk="Microsoft.NET.Sdk">

  <!-- An executable that runs its own tests of MGQOnline.Game, see "Tests" in docs/DEVELOPER.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RootNamespace>MGQOnline.Game.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MGQOnline.Game\MGQOnline.Game.csproj" />

    <!-- The generator writes the events database the rules are tested over, from the tiny game and the game folder. -->
    <ProjectReference Include="..\MGQOnline.Data.Generator\MGQOnline.Data.Generator.csproj" />
  </ItemGroup>

  <!-- The relay's seed of the story tables, which the catch-up tables and the shipped keys are read from. -->
  <ItemGroup>
    <None Include="..\Relay\seed\story\*.json" LinkBase="seed" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
