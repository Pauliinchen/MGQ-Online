<Project Sdk="Microsoft.NET.Sdk">

  <!-- An executable that runs its own tests of MGQOnline.Game, see "Tests" in docs/DEVELOPER.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RootNamespace>MGQOnline.Game.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MGQOnline.Game\MGQOnline.Game.csproj" />
  </ItemGroup>

  <!-- The golden cases Ruby wrote, shared with the Ruby side's tests. -->
  <ItemGroup>
    <None Include="..\fixtures\wire\*.json" LinkBase="fixtures\wire" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\catchup\*.json" LinkBase="fixtures\catchup" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\mods\*.json" LinkBase="fixtures\mods" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\story\*.json" LinkBase="fixtures\story" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\peers\*.json" LinkBase="fixtures\peers" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\squad\*.json" LinkBase="fixtures\squad" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\ui\*.json" LinkBase="fixtures\ui" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\events\*.json" LinkBase="fixtures\events" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\overview\*.json" LinkBase="fixtures\overview" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\world\*.json" LinkBase="fixtures\world" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\worlds\*.json" LinkBase="fixtures\worlds" CopyToOutputDirectory="PreserveNewest" />
