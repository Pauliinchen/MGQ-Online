<Project Sdk="Microsoft.NET.Sdk">

  <!-- The game-side rules that move out of the scripts, one folder per area. It runs in the
       NativeAOT win-x86 mod DLL and the linux-x64 battle server core, so it stays AOT-clean, uses
       only the BCL and keeps no state in statics. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MGQOnline.Game</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MGQOnline.Game.Tests" />
  </ItemGroup>

</Project>
