<Project Sdk="Microsoft.NET.Sdk">

  <!-- The raid arena's rules: runtime model, simulation and engine. It runs in the NativeAOT win-x86
       mod DLL, the linux-x64 battle server and the Raid Designer, so it stays AOT-clean and uses
       only the BCL. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MGQOnline.Arena</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MGQOnline.Arena.Tests" />
  </ItemGroup>

</Project>
