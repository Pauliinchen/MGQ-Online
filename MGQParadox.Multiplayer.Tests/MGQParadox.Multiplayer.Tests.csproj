<Project Sdk="Microsoft.NET.Sdk">

  <!-- An executable that runs its own tests, see "Tests" in docs/DEVELOPER.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!-- The DLL project builds for the 32-bit game, so its assembly only loads into a 32-bit process. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />

    <!-- Only for its native SQLite library, which the JIT run loads where the publish links SQLite in. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MGQParadox.Multiplayer\MGQParadox.Multiplayer.csproj" />

    <!-- The generator writes the events database of the tiny game the event topics are tested over. -->
    <ProjectReference Include="..\MGQOnline.Data.Generator\MGQOnline.Data.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MGQOnline.Game.Tests\Events\TinyGame.cs" Link="Topics\TinyGame.cs" />
  </ItemGroup>

  <!-- The export table of the scripts, which ExportsTests compares with the exports. -->
  <ItemGroup>
    <None Include="..\GameScript\Multiplayer.rb" Link="GameScript\Multiplayer.rb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
