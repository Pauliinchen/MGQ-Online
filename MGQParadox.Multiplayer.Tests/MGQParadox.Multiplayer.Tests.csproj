<Project Sdk="Microsoft.NET.Sdk">

  <!-- An executable that runs its own tests, see "Tests" in docs/DEVELOPER.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!-- The DLL project builds for the 32-bit game, so its assembly only loads into a 32-bit process. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MGQParadox.Multiplayer\MGQParadox.Multiplayer.csproj" />

    <!-- The helper links some of the DLL's files, so its types go under an alias of their own;
         its Helper.exe lands next to the tests, which run it as the DLL would. -->
    <ProjectReference Include="..\MGQOnline.Helper\MGQOnline.Helper.csproj" Aliases="helper" />
  </ItemGroup>

  <!-- The golden answers of the topics, shared with the script tests. -->
  <ItemGroup>
    <None Include="..\fixtures\world\*.json" LinkBase="fixtures\world" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\squad\*.json" LinkBase="fixtures\squad" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\story\classes.json" LinkBase="fixtures\story" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\overview\*.json" LinkBase="fixtures\overview" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\worlds\*.json" LinkBase="fixtures\worlds" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
