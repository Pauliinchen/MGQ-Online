<Project Sdk="Microsoft.NET.Sdk">

  <!-- Helper.exe in Patch\Multiplayer: the update, the restart and the parked mods' watchdog,
       which run while the game is closed. The DLL project's publish publishes it into the
       package, see docs/DEVELOPER.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>Helper</AssemblyName>
    <RootNamespace>MGQOnline.Helper</RootNamespace>
    <Product>Monster Girl Quest! Online</Product>
    <Version>0.0.0-dev</Version>

    <!-- 32-bit and native like the DLL, so it runs wherever the game does, Wine included, which
         has no PowerShell. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MGQParadox.Multiplayer.Tests" />
  </ItemGroup>

  <!-- The DLL's own rules, linked in so the helper never keeps a copy of them. -->
  <ItemGroup>
    <Compile Include="..\MGQParadox.Multiplayer\ModFolder.cs" Link="Linked\ModFolder.cs" />
    <Compile Include="..\MGQParadox.Multiplayer\ReleaseVersion.cs" Link="Linked\ReleaseVersion.cs" />
    <Compile Include="..\MGQParadox.Multiplayer\Mods\FolderGuard.cs" Link="Linked\Mods\FolderGuard.cs" />
    <Compile Include="..\MGQParadox.Multiplayer\Mods\ModHash.cs" Link="Linked\Mods\ModHash.cs" />
    <Compile Include="..\MGQParadox.Multiplayer\Mods\ModParking.cs" Link="Linked\Mods\ModParking.cs" />
    <Compile Include="..\MGQParadox.Multiplayer\Mods\ReleaseDownload.cs" Link="Linked\Mods\ReleaseDownload.cs" />
    <Compile Include="..\MGQParadox.Multiplayer\Network\Transport\Message.cs" Link="Linked\Network\Transport\Message.cs" />
  </ItemGroup>

</Project>
